# ayqaealhayaa.sa — settings. Copy to .env (or enter them in the hosting panel). Never commit real values.
NODE_ENV=production
PORT=3100

# MySQL / MariaDB database
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/ayqae_store

# Random secret, at least 32 characters
JWT_SECRET=CHANGE_ME

# Website admin (/admin) login
BILLING_ADMIN_EMAIL=admin@ayqaealhayaa.sa
BILLING_ADMIN_PASSWORD=CHANGE_ME

# Online payment: the cart is sent to the pay site, signed with this secret.
# Must be the SAME value as "handoffSecret" in the pay site's config.json. At least 32 characters.
PAY_HANDOFF_SECRET=CHANGE_ME
PAY_SITE_URL=https://pay.ayqaealhayaa.sa
STORE_URL=https://ayqaealhayaa.sa

# Folder for uploaded images (served at /manus-storage/...)
UPLOAD_DIR=uploads

# Old CCAvenue integration stays off
CCAVENUE_LIVE_PAYMENTS_ENABLED=false
