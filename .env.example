# Public production URL with no trailing slash.
APP_ORIGIN=https://your-store-domain.example

# MySQL connection for persistent products and orders.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Required only when enabling live Stripe Checkout.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

# Optional. Defaults to 3000.
PORT=3000
